---
import { Image } from 'astro:assets';
import logoud from '../assets/LOGOTIPO---UD-FCE-BLANCO.png';
---

<footer class="bg-navy-950 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">

      <!-- Left: University logo + lab name -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <div class="flex items-center gap-3">
<Image
  src={logoud}
  alt="Universidad Distrital Francisco José de Caldas"
  class="h-12 w-auto object-contain"
/>

       </div>

        <div class="hidden sm:block w-px h-12 bg-white/10"></div>

        <div>
          <p class="text-white font-display font-bold text-sm">Laboratorio de Archivística</p>
          <p class="text-white/40 text-xs">y Humanidades Digitales</p>
        </div>
      </div>

      <!-- Right: Copyright -->
      <div class="flex flex-col items-start md:items-end gap-3">
        <p class="text-white/30 text-xs">© {new Date().getFullYear()} Universidad Distrital Francisco José de Caldas</p>
      </div>

    </div>
  </div>
</footer>
