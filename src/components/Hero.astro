---
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredNews = allNews.slice(0, 3);

const slides = [
  {
    eyebrow: 'Universidad Distrital Francisco José de Caldas',
    title: 'Laboratorio de Archivística y Tecnologías Digitales',
    subtitle: 'Gestión, análisis y transformación de la información con tecnología, innovación y compromiso social.',
    image: null,
    cta: [
      { label: 'Solicitud de Paz y Salvo', href: 'https://forms.office.com/pages/responsepage.aspx?id=74gT1bBqY0OflNVmRKRZcCYdtW4rSUhOkGItZSP0FSVUQlU5QVFCQlJBWFE2QVhHRVk5S1k1ODZOOS4u&route=shorturl', primary: true },
      { label: 'Reservar laboratorio', href: 'https://forms.cloud.microsoft/pages/responsepage.aspx?id=74gT1bBqY0OflNVmRKRZcCYdtW4rSUhOkGItZSP0FSVUMkxQQTdaVUxZMlg4RTIyMFhJMTNJUU5RRC4u&route=shorturl', primary: false },
    ],
  },
  ...featuredNews.map((n) => ({
    eyebrow: (() => { const d = n.data.date; const meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre']; return `${d.getUTCDate()} de ${meses[d.getUTCMonth()]} de ${d.getUTCFullYear()}`; })(),
    title: n.data.title,
    subtitle: n.data.excerpt,
    image: n.data.image || null,
    cta: [{ label: 'Leer noticia', href: `/noticias/${n.id}/`, primary: true }],
  })),
];
---

<section class="relative bg-navy-900 overflow-hidden h-[440px] lg:h-[520px]" id="hero-carousel">
  <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
  <div class="absolute right-0 top-0 w-2/3 h-full bg-gradient-to-l from-accent-600/10 via-transparent to-transparent pointer-events-none"></div>
  <div class="absolute right-20 top-1/2 -translate-y-1/2 w-96 h-96 bg-accent-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Right illustration (blueprint or news image) -->
  {slides.map((slide, i) => (
    <div
      class="hero-illustration absolute right-0 top-0 bottom-0 w-1/2 hidden lg:flex items-center justify-center overflow-hidden transition-opacity duration-700 ease-in-out"
      class:list={{ 'opacity-0': i !== 0, 'opacity-100': i === 0 }}
      data-index={i}
    >
      {slide.image ? (
        <img src={slide.image} alt="" class="w-full h-full object-contain p-8" />
      ) : (
        <div class="relative w-full h-full flex items-center justify-end pr-8">
          <svg viewBox="0 0 520 480" class="w-[440px] h-[400px] opacity-20 text-accent-400" fill="none" stroke="currentColor" stroke-width="0.8">
            <rect x="100" y="80" width="320" height="240" rx="8" stroke-width="1.5"/>
            <rect x="110" y="90" width="300" height="220" rx="4"/>
            <line x1="130" y1="120" x2="280" y2="120"/>
            <line x1="130" y1="135" x2="260" y2="135"/>
            <line x1="130" y1="150" x2="300" y2="150"/>
            <line x1="130" y1="165" x2="240" y2="165"/>
            <rect x="130" y="180" width="80" height="60" rx="2"/>
            <rect x="225" y="180" width="80" height="60" rx="2"/>
            <circle cx="400" cy="120" r="40" stroke-dasharray="5 3"/>
            <circle cx="400" cy="120" r="25"/>
            <circle cx="400" cy="120" r="5" fill="currentColor" stroke="none"/>
            <path d="M60 60 L60 40 L80 40"/>
            <path d="M460 60 L460 40 L440 40"/>
            <path d="M60 380 L60 400 L80 400"/>
            <path d="M460 380 L460 400 L440 400"/>
            <line x1="60" y1="430" x2="460" y2="430" stroke-dasharray="4 2"/>
            <rect x="350" y="270" width="100" height="55" rx="3"/>
          </svg>
        </div>
      )}
    </div>
  ))}

  <!-- Slides container (no relative — slides position to section) -->
  <div class="z-10 w-full h-full">
    {slides.map((slide, i) => (
      <div
        class="hero-slide absolute inset-0 flex items-center transition-opacity duration-700 ease-in-out"
        class:list={{ 'opacity-0 pointer-events-none': i !== 0, 'opacity-100 pointer-events-auto': i === 0,}}
        data-index={i}
        >
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
          <div class="max-w-xl">
            <div class="flex items-center gap-2 mb-6">
              <div class="w-8 h-px bg-accent-400"></div>
              <span class="text-accent-400 text-xs font-semibold tracking-widest uppercase">{slide.eyebrow}</span>
            </div>
            <h1 class="font-display font-bold text-white leading-tight mb-6 text-3xl sm:text-4xl lg:text-[44px]">
              {slide.title}
            </h1>
            <p class="text-white/70 text-base sm:text-lg leading-relaxed mb-10 max-w-md">
              {slide.subtitle}
            </p>
            <div class="flex flex-wrap gap-3">
              {slide.cta.map((btn) => (
                <a
                  href={btn.href}
                  class:list={{
                    'inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold px-6 py-3 rounded transition-all duration-200 group': btn.primary,
                    'inline-flex items-center gap-2 border border-white/30 hover:border-white/60 text-white font-semibold px-6 py-3 rounded transition-all duration-200': !btn.primary,
                  }}
                >
                  {btn.label}
                  {btn.primary && (
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Arrows -->
  <button id="carousel-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 flex items-center justify-center rounded-full border border-white/20 bg-navy-900/60 backdrop-blur-sm text-white/70 hover:text-white hover:bg-navy-900/90 transition-all duration-200 cursor-pointer">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
    </svg>
  </button>
  <button id="carousel-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 flex items-center justify-center rounded-full border border-white/20 bg-navy-900/60 backdrop-blur-sm text-white/70 hover:text-white hover:bg-navy-900/90 transition-all duration-200 cursor-pointer">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
    </svg>
  </button>

  <!-- Dots -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
    {slides.map((_, i) => (
      <button
        class="carousel-dot w-2.5 h-2.5 rounded-full border-0 cursor-pointer transition-all duration-300"
        class:list={{
          'bg-accent-400 w-6': i === 0,
          'bg-white/30 hover:bg-white/50': i !== 0,
        }}
        data-index={i}
      ></button>
    ))}
  </div>
</section>

<script>
  let interval;

  function initCarousel() {
    const container = document.getElementById('hero-carousel');
    if (!container) return; 

    const slides = container.querySelectorAll('.hero-slide');
    const illustrations = container.querySelectorAll('.hero-illustration');
    const dots = container.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    let current = 0;
    const total = slides.length;
    let isPaused = false;

    function goTo(index) {
      if (index === current) return;
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-0', i !== index);
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('pointer-events-none', i !== index);
        s.classList.toggle('pointer-events-auto', i === index);
      });
      illustrations.forEach((s, i) => {
        s.classList.toggle('opacity-0', i !== index);
        s.classList.toggle('opacity-100', i === index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('bg-accent-400', i === index);
        d.classList.toggle('w-6', i === index);
        d.classList.toggle('bg-white/30', i !== index);
        d.classList.toggle('hover:bg-white/50', i !== index);
      });
      current = index;
    }

    function next() { goTo((current + 1) % total); }
    function prev() { goTo((current - 1 + total) % total); }

    function tick() {
      if (!isPaused) next();
    }

    clearInterval(interval);
    interval = setInterval(tick, 6000);

    prevBtn?.addEventListener('click', () => { prev(); });
    nextBtn?.addEventListener('click', () => { next(); });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.dataset.index));
      });
    });

    container.addEventListener('mouseenter', () => { isPaused = true; });
    container.addEventListener('mouseleave', () => { isPaused = false; });
  }

  document.addEventListener('astro:page-load', initCarousel);

  document.addEventListener('astro:before-swap', () => {
    clearInterval(interval);
  });
</script>
