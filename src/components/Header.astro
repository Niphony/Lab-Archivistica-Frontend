---
import { Image } from 'astro:assets';
import logoud from '../assets/LOGOTIPO---UD-FCE-BLANCO.png';
import logolab from '../assets/LOGO 000000_white.png'

const navLinks = [
  { label: 'Inicio',       href: '/',                        active: Astro.url.pathname === '/' },
  { label: 'Servicios',    href: '/servicios',               active: Astro.url.pathname.startsWith('/servicios') },
  { label: 'Software',     href: '/software',                active: Astro.url.pathname.startsWith('/software') },
  { label: 'Equipos',      href: '/equipos',                 active: Astro.url.pathname.startsWith('/equipos') },
  { label: 'Noticias y Eventos',     href: '/noticias',      active: Astro.url.pathname.startsWith('/noticias') },
  { label: 'Contacto',     href: '/#ContactoFooter'},
];
---

<header class="bg-navy-900 border-b border-white/10 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center h-16 lg:h-17.5">

      <!-- Logo left -->
      <a href="/" class="flex items-center gap-3 shrink-0">
      <div class="flex items-center">
  <Image
    src={logoud}
    alt="Universidad Distrital Francisco José de Caldas"
    class="h-20 w-auto object-contain"
  />
</div> 

        <!-- Divider -->
        <div class="w-px h-10 bg-white/20 mx-1 hidden md:block"></div>

        <!-- Lab logo -->
        <div class="hidden md:flex items-center gap-2">
           <div class="w-15 h-15 rounded flex items-center justify-center">
          <Image
              src={logolab}
              alt='Laboratorio de Archivistica y Humanidades Digitales logo'
              class="h-12 w-auto object-contain" 
              />
          </div>
          <div>
            <p class="text-[9px] text-white/50 uppercase tracking-widest leading-none">Laboratorio de</p>
            <p class="text-white font-display font-bold text-sm leading-tight">ARCHIVÍSTICA</p>
            <p class="text-[9px] text-white/50 uppercase tracking-widest leading-none">Y HUMANIDADES DIGITALES</p>
          </div>
        </div>
      </a>

            <!-- Nav links desktop -->
      <nav class="hidden lg:flex items-center gap-1 ml-auto">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-2 text-sm font-semibold tracking-wide transition-colors duration-150 rounded
              ${link.active
                ? 'text-accent-400 border-b-2 border-accent-400 rounded-none'
                : 'text-white/70 hover:text-white'
              }`}
          >
            {link.label.toUpperCase()}
          </a>
        ))}
      
<a
  href="https://aulasvirtuales.udistrital.edu.co/"
  target="_blank"
  class="hidden lg:inline-flex items-center px-4 py-2 bg-accent-500 hover:bg-accent-600 text-white text-sm font-semibold rounded transition-colors duration-150"
>
  Moodle
</a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-btn"
        class="lg:hidden text-white/70 hover:text-white p-2"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-navy-800 border-t border-white/10">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
       <a 
      href="https://aulasvirtuales.udistrital.edu.co/" 
      target="_blank" 
      class="px-3 py-2 text-sm font-semibold rounded transition-colors bg-accent-500 hover:bg-accent-600 text-white text-center"
    >
      Moodle
    </a>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-3 py-2 text-sm font-semibold tracking-wide rounded transition-colors
            ${link.active ? 'text-accent-400 bg-accent-500/10' : 'text-white/70 hover:text-white hover:bg-white/5'}`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
