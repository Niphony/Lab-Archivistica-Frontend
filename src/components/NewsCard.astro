---
export interface Props {
  title: string;
  date: Date;
  excerpt: string;
  id: string;
  author?: string;
}

const { title, date, excerpt, id, author } = Astro.props;

const formattedDate = date.toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group bg-navy-800/50 border border-white/10 rounded-xl overflow-hidden hover:border-accent-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-accent-500/5 flex flex-col">
  <a href={`/noticias/${id}/`} class="flex flex-col h-full p-6">
    <div class="flex items-center gap-2 text-xs text-white/40 mb-3">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {author && (
        <>
          <span class="w-1 h-1 rounded-full bg-white/20"></span>
          <span>{author}</span>
        </>
      )}
    </div>
    <h3 class="font-display font-bold text-white text-lg leading-snug mb-3 group-hover:text-accent-400 transition-colors duration-200">
      {title}
    </h3>
    <p class="text-white/60 text-sm leading-relaxed line-clamp-3 flex-1">
      {excerpt}
    </p>
    <div class="mt-4 flex items-center gap-1.5 text-accent-400 text-sm font-semibold group/link">
      Leer más
      <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
      </svg>
    </div>
  </a>
</article>
