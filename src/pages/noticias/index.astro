---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';

const allNews = await getCollection('news');
allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Noticias — Laboratorio de Archivística">
  <section class="bg-navy-900 border-b border-white/10 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 text-xs font-bold tracking-widest text-accent-400 border border-accent-400/30 rounded-full mb-4 uppercase">Noticias</span>
      <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-4">Tablón de Noticias</h1>
      <p class="text-white/60 max-w-2xl mx-auto text-lg">Últimas novedades, eventos y anuncios del Laboratorio de Archivística.</p>
    </div>
  </section>

  <section class="bg-navy-950 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {allNews.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {allNews.map((n) => (
            <NewsCard
              title={n.data.title}
              date={n.data.date}
              excerpt={n.data.excerpt}
              id={n.id}
              author={n.data.author}
              image={n.data.image}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <svg class="w-16 h-16 mx-auto text-white/10 mb-6" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-white/40 text-lg">No hay noticias publicadas aún.</p>
          <p class="text-white/20 text-sm mt-2">Las próximas novedades aparecerán aquí.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
