\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{1pt}
\fancyhead[L]{\includegraphics[height=1.2cm]{ud-color.png}}
\fancyhead[R]{\large\bfseries\color{labnavy}\@doctitulo}
\fancyfoot[C]{%
    \begin{tikzpicture}[baseline=(current bounding box.center)]
        \node[
            font=\sffamily\bfseries\color{labnavy},
            inner sep=5pt
        ] (num) {\thepage};
        \draw[labgris, line width=0.5pt] (num.west) -- ++(-2cm,0);
        \draw[labgris, line width=0.5pt] (num.east) -- ++(2cm,0);
    \end{tikzpicture}%
}
\renewcommand{\footrulewidth}{0pt}

\newcommand{\chaptercolor}{labnavy}
\titleformat{\chapter}[block]
    {\Huge\bfseries\color{\chaptercolor}\sffamily}
    {\begin{tikzpicture}[baseline=(char.base)]
            \node[rectangle, fill=labnavy, rounded corners=3pt, inner sep=6pt] (char) {\color{white}\thechapter};
        \end{tikzpicture}}
    {1em}
    {\Huge\bfseries\color{\chaptercolor}}
    [\vspace{0.5em}{\color{labcyan}\titlerule[2pt]}\thispagestyle{chapternoline}]

\fancypagestyle{chapternoline}{
    \fancyhf{}
    \fancyfoot[C]{%
        \begin{tikzpicture}[baseline=(current bounding box.center)]
            \node[
                font=\sffamily\bfseries\color{labnavy},
                inner sep=5pt
            ] (num) {\thepage};
            \draw[labgris, line width=0.5pt] (num.west) -- ++(-2cm,0);
            \draw[labgris, line width=0.5pt] (num.east) -- ++(2cm,0);
        \end{tikzpicture}%
    }
    \renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
}

\titleformat{\section}
    {\Large\bfseries\color{labnavy}\sffamily}
    {\thesection}{1em}{}
\titleformat{\subsection}
    {\large\bfseries\color{labgris}\sffamily}
    {\thesubsection}{1em}{}
\titleformat{\subsubsection}
    {\normalsize\bfseries\color{labgris}\sffamily}
    {\thesubsubsection}{1em}{}

\lstset{
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{labgrisclaro!40},
    commentstyle=\color{labgris},
    keywordstyle=\color{labcyandark}\bfseries,
    stringstyle=\color{labnavy},
    numberstyle=\tiny\color{labgris},
    breaklines=true,
    breakatwhitespace=true,
    postbreak=\mbox{\textcolor{labgris}{$\hookrightarrow$}\space},
    showstringspaces=false,
    tabsize=2,
    frame=none,
    rulecolor=\color{labgris!30},
    columns=fullflexible,
    keepspaces=true,
    upquote=true
}

\newcommand{\terminalblock}[1]{%
    \begin{mdframed}[style=terminalstyle]
        \textcolor{labcyandark}{\textbf{Terminal:}}\\[0.3em]
        \begin{flushleft}
            \ttfamily\small
            \def\\{\par\vspace{0.2em}}%
            #1
        \end{flushleft}
    \end{mdframed}%
}

\newcommand{\codeblock}[2][]{%
    \begin{mdframed}[style=codestyle]
        \ifx\relax#1\relax\else
            \textcolor{labgris}{\textbf{#1}}\\[0.3em]
        \fi
        \begin{flushleft}
            \ttfamily\small
            \def\\{\par\vspace{0.2em}}%
            #2
        \end{flushleft}
    \end{mdframed}%
}

\newcommand{\singlecmd}[1]{%
    \begin{mdframed}[style=terminalstyle]
        \textcolor{labcyandark}{\textbf{Terminal:}}\\[0.3em]
        \texttt{\textcolor{black}{#1}}
    \end{mdframed}%
}

\newcommand{\multicmd}[1]{%
    \begin{mdframed}[style=terminalstyle]
        \textcolor{labcyandark}{\textbf{Terminal:}}\\[0.3em]
        \small\ttfamily
        \begin{tabular}{@{}l@{}}
            #1
        \end{tabular}
    \end{mdframed}%
}

\RenewDocumentCommand{\texttt}{m}{%
  \begingroup
    \ttfamily
    \hyphenchar\font=`\-%
    \exhyphenpenalty=10000 %
    \emergencystretch=1em %
    \raggedright
    #1%
  \endgroup
}

