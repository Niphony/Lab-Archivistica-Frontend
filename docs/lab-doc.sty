      \includegraphics[height=2.4cm]{lab-blanco.png}%
      \hfill
      \begin{minipage}{0.5\textwidth}
        \raggedleft
        {\large\textbf{UNIVERSIDAD DISTRITAL}\\[2pt]
         FRANCISCO JOSÉ DE CALDAS}\\[4pt]
        {\large\textbf{Facultad de Ingeniería}}
      \end{minipage}
    \end{flushleft}
    \vspace{7cm}
    {\Huge\bfseries\@doctitulo}\\[0.4cm]
    {\Large\color{labcyan}\@docsubtitulo}
